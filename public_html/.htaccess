RewriteEngine On
RewriteBase /

# Block sensitive files and internal directories from public access.
RewriteRule ^logs/ - [F,L]
RewriteRule ^vendor/ - [F,L]
RewriteRule ^scripts/ - [F,L]
RewriteRule ^includes/ - [F,L]
RewriteRule ^helpers/ - [F,L]
RewriteRule ^\.env$ - [F,L]
RewriteRule ^\.git - [F,L]
RewriteRule \.(sql|sqlite|dump|bak|zip|tar|gz|tgz)$ - [F,L]
RewriteRule \.log$ - [F,L]

# Force HTTPS (best-effort). If you're behind a proxy/load balancer, ensure it sets X-Forwarded-Proto=https.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Security headers (best-effort; requires mod_headers).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"

  # HSTS (only meaningful over HTTPS).
  Header always set Strict-Transport-Security "max-age=31536000"

  # CSP is managed dynamically in PHP (includes/security_headers.php) with per-request nonces.
  # A static CSP here cannot include nonces and would break all inline scripts.
</IfModule>

# Redirect requests that explicitly include .php to their extensionless form.
# Exclude POST requests to prevent data loss.
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?]
RewriteRule ^ %1 [R=301,NE,L]

# Direct friendly URLs
RewriteRule ^mpicap/?$ mpicap.php [L,QSA]
RewriteRule ^mpi_cap_comparison/?$ mpicap.php [L,QSA]

# Serve existing PHP files when the request omits the extension.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

